      "item": [
        {
          "name": "User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const chars = \"abcdefghijklmnopqrstuvwxyz\";\nconst upper = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\";\nconst numbers = \"0123456789\";\nconst special = \"!@#$%&*\";\n\nlet password = \"\";\npassword += upper.charAt(Math.floor(Math.random() * upper.length));\npassword += numbers.charAt(Math.floor(Math.random() * numbers.length));\npassword += special.charAt(Math.floor(Math.random() * special.length));\n\nfor (let i = 0; i < 9; i++) {\n    const all = chars + upper + numbers + special;\n    password += all.charAt(Math.floor(Math.random() * all.length));\n}\n\npassword = password.split('').sort(() => Math.random() - 0.5).join('');\n\npm.environment.set(\"password\", password);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\n    pm.response.to.have.status(201);\n});\n\nconst response = pm.response.json();\n\npm.environment.set(\"userId\", response.userID);\npm.environment.set(\"userName\", response.username);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"userName\": \"{{$randomUserName}}\",\r\n  \"password\": \"{{password}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
