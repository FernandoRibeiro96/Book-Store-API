    {
      "name": "BookStore",
      "item": [
        {
          "name": "Books",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\nconst response = pm.response.json();\nconst isbns = response.books.map(book => book.isbn);\npm.environment.set(\"isbns\", isbns.join(\",\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/BookStore/v1/Books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "BookStore",
                "v1",
                "Books"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Hire Books",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Pega os ISBNs salvos no environment\nconst isbnsRaw = pm.environment.get(\"isbns\");\nif (!isbnsRaw) {\n    console.error(\"Variável 'isbns' não encontrada no environment. Execute a requisição Books primeiro.\");\n    return;\n}\n\nconst isbns = isbnsRaw.split(\",\");\n\n// Embaralha o array (Fisher-Yates shuffle)\nfor (let i = isbns.length - 1; i > 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    [isbns[i], isbns[j]] = [isbns[j], isbns[i]];\n}\n\n// Seleciona os 2 primeiros ISBNs únicos após o embaralhamento\npm.environment.set(\"isbn1\", isbns[0]);\npm.environment.set(\"isbn2\", isbns[1]);\n\nconsole.log(\"ISBNs selecionados:\", isbns[0], isbns[1]);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"userId\": \"{{userId}}\",\r\n  \"collectionOfIsbns\": [\r\n    {\r\n      \"isbn\": \"{{isbn1}}\"\r\n    },\r\n    {\r\n      \"isbn\": \"{{isbn2}}\"\r\n    }\r\n  ]\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/BookStore/v1/Books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "BookStore",
                "v1",
                "Books"
              ]
            }
          },
          "response": []
